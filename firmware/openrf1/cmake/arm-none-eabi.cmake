set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(ARM_GCC_ROOT "" CACHE PATH "Arm GNU Toolchain installation directory")
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ARM_GCC_ROOT)
find_program(ARM_CC arm-none-eabi-gcc HINTS "${ARM_GCC_ROOT}/bin" "$ENV{ARM_GCC_ROOT}/bin" REQUIRED)
get_filename_component(ARM_BIN "${ARM_CC}" DIRECTORY)
set(CMAKE_C_COMPILER "${ARM_CC}")
set(CMAKE_ASM_COMPILER "${ARM_CC}")
find_program(CMAKE_OBJCOPY arm-none-eabi-objcopy HINTS "${ARM_BIN}" REQUIRED)
find_program(ARM_SIZE arm-none-eabi-size HINTS "${ARM_BIN}" REQUIRED)
