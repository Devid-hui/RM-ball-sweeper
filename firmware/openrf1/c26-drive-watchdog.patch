+
+void app_motor_uart_speed_set(float a, float b, float c, float d)
+{
+    uint32_t irq_mask = __get_PRIMASK();
+    __disable_irq();
+    motor_speed_set(a, b, c, d);
+    uart_drive_ticks = (a != 0 || b != 0 || c != 0 || d != 0) ? UART_DRIVE_TIMEOUT_TICKS : 0;
+    __set_PRIMASK(irq_mask);
